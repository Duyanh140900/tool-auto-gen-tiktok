# ==============================================================================
# TikTok Review Tool - Configuration Template (.env.example)
# ==============================================================================
# Sao chép file này thành .env và điền các thông tin cấu hình phù hợp:
#   copy .env.example .env     (Windows CMD)
#   cp .env.example .env       (Linux / macOS)
#
# LƯU Ý: Tuyệt đối KHÔNG commit file .env lên Git để bảo mật API key!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TTS Provider: Itera102 (ElevenLabs Voice Engine)
# ------------------------------------------------------------------------------
# Hỗ trợ tạo giọng đọc AI chất lượng cao với cảm xúc (ElevenLabs v3 tags).
# Lấy API Key và Voice ID trên hệ thống Itera102 (https://itera102.space).
#
ITERA102_API_KEY=sk_your_itera102_api_key_here
ITERA102_VOICE_ID=pNInz6obpgDQGcFmaJgB
ITERA102_BASE_URL=https://api.itera102.space
ITERA102_PROVIDER=elevenlabs
ITERA102_MODEL_ID=eleven_v3
ITERA102_LANGUAGE_CODE=vi
ITERA102_SPEED=1.2
ITERA102_STABILITY=0.5
ITERA102_SIMILARITY_BOOST=0.75
ITERA102_STYLE=0.0
ITERA102_USE_SPEAKER_BOOST=true
ITERA102_EXPORT_TRANSCRIPT=false
ITERA102_REQUEST_TIMEOUT_SEC=60
ITERA102_POLL_INTERVAL_SEC=2.5
ITERA102_POLL_MAX_ATTEMPTS=90
ITERA102_DOWNLOAD_TIMEOUT_SEC=120

# ------------------------------------------------------------------------------
# 2. TTS Fallback: Microsoft Edge TTS (Miễn phí, không cần API Key)
# ------------------------------------------------------------------------------
# Dùng cho chế độ review thông thường hoặc fallback.
# Giọng nam tiếng Việt: vi-VN-NamMinhNeural
# Giọng nữ tiếng Việt: vi-VN-HoaiMyNeural
#
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_SPEED=1.15

# ------------------------------------------------------------------------------
# 3. LLM Provider (Sinh kịch bản tự động từ link TikTok / Tên sản phẩm)
# ------------------------------------------------------------------------------
# Hỗ trợ 3 chế độ kết nối:
#
# --- Cách 1: Sử dụng 9Router Proxy cục bộ (Khuyến nghị nếu chạy 9Router trên máy) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-your_9router_key_here
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=Coder
#
# --- Cách 2: Sử dụng OpenAI API trực tiếp ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# --- Cách 3: Sử dụng Anthropic Claude API ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 4. Thư mục xuất video (Output Directories)
# ------------------------------------------------------------------------------
# Mặc định hệ thống tự động lưu vào ~/tiktok-review-tool/ (Home directory).
# Bạn có thể bỏ comment và đổi sang đường dẫn riêng nếu muốn:
# OUTPUT_DIR=./outputs
# FINAL_OUTPUT_DIR=./final_videos

# ------------------------------------------------------------------------------
# 5. Video & Rendering Settings
# ------------------------------------------------------------------------------
VIDEO_QUALITY=high
AUDIO_BITRATE=192k
MAX_CONCURRENT=1

# ------------------------------------------------------------------------------
# 6. TikTok Downloader & Cookies (Tùy chọn)
# ------------------------------------------------------------------------------
# Đường dẫn tới file cookies.txt (Netscape format) xuất từ trình duyệt nếu video
# bị chặn vùng, giới hạn độ tuổi hoặc TikTok chỉ trả về luồng audio không có video.
# TIKTOK_COOKIES_FILE=./cookies.txt

# ------------------------------------------------------------------------------
# 7. Tự thêm sản phẩm vào Showcase sau khi gen video (Tùy chọn)
# ------------------------------------------------------------------------------
# Cần điện thoại Android đăng nhập TikTok creator, bật Gỡ lỗi USB, và:
#   pip install uiautomator2 && python -m uiautomator2 init
# Kết quả ghi vào <FINAL_OUTPUT_DIR>/showcase_log.csv.
# Nhiều thiết bị cắm cùng lúc thì chỉ định serial (xem bằng `adb devices`):
# SHOWCASE_DEVICE_SERIAL=

# ------------------------------------------------------------------------------
# 8. Đăng hẹn giờ TikTok Studio + gắn giỏ hàng (Tùy chọn)
# ------------------------------------------------------------------------------
# Cần: pip install playwright (dùng Chrome có sẵn; không có Chrome thì
# python -m playwright install chromium). Lần đầu đăng nhập TikTok trên cửa sổ
# Chrome tool mở ra; phiên lưu ở .tiktok_browser_profile/.
# Lịch cố định 08:00, 12:00, 18:00, 22:00, tiếp nối bài hẹn muộn nhất ở màn Posts.
# Sổ lịch: <FINAL_OUTPUT_DIR>/post_schedule.json
# Số ngày tối đa TikTok cho hẹn trước (quá thì video vào hàng chờ):
# POST_SCHEDULE_MAX_DAYS=30
# Nghỉ giữa 2 bài đăng (giây, ngẫu nhiên trong khoảng), mặc định không nghỉ:
# POST_DELAY_SECONDS=60-120
# Nghỉ giữa 2 link khi thêm Showcase trên điện thoại, mặc định 8-15:
# SHOWCASE_DELAY_SECONDS=8-15

# ------------------------------------------------------------------------------
# 9. Bot Telegram: gửi link TikTok vào chat -> chạy AI Video (Tùy chọn)
# ------------------------------------------------------------------------------
# Tạo bot với @BotFather để lấy token. Bot chạy cùng backend (dev_all.cmd) và
# dùng đúng setting đang chọn ở trang /ai-video (lưu tại .ai_video_defaults.json).
# Lần đầu nhắn bot, bot trả lời Chat ID -> điền vào TELEGRAM_ALLOWED_CHAT_IDS
# (nhiều ID cách nhau dấu phẩy) rồi khởi động lại backend.
# Lệnh: /status /settings /queue /clear
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_ALLOWED_CHAT_IDS=
# Gửi luôn file video (<= 49MB) về Telegram khi xong:
# TELEGRAM_SEND_VIDEO=false
