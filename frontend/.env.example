# ==============================================================================
# Frontend Environment Configuration (.env.example)
# ==============================================================================
# Nếu bạn chạy frontend tách riêng với backend (khác port hoặc khác host),
# cấu hình các biến dưới đây:
#
# NEXT_PUBLIC_API_TARGET: Địa chỉ Backend FastAPI (mặc định http://127.0.0.1:8000)
# NEXT_PUBLIC_API_BASE_URL: URL trực tiếp (để trống nếu dùng reverse proxy của Next.js)
# NEXT_PUBLIC_WS_BASE_URL: URL WebSocket trực tiếp tới FastAPI, không qua Next.js rewrite
#
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_TARGET=http://127.0.0.1:8000
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000
